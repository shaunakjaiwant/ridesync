# RideSync environment template
# Copy to .env or configure these variables in your hosting platform.

RIDESYNC_ENV=production
RIDESYNC_DEBUG=false
RIDESYNC_TIMEZONE=Asia/Kolkata

RIDESYNC_DB_HOST=127.0.0.1
RIDESYNC_DB_PORT=3306
RIDESYNC_DB_NAME=ridesync_db
RIDESYNC_DB_USER=ridesync_app
RIDESYNC_DB_PASSWORD=change-me
RIDESYNC_DB_CONNECT_TIMEOUT=5

# Set true only behind a trusted reverse proxy that controls X-Forwarded-*.
RIDESYNC_TRUST_PROXY=false
RIDESYNC_ALLOWED_ORIGINS=

# Set true when serving only over HTTPS.
RIDESYNC_COOKIE_SECURE=true
RIDESYNC_SESSION_IDLE_SECONDS=1800
RIDESYNC_SESSION_ABSOLUTE_SECONDS=28800
RIDESYNC_SESSION_ROTATE_SECONDS=900

RIDESYNC_STORAGE_DIR=
RIDESYNC_DOCUMENT_ENCRYPTION_KEY=

RIDESYNC_VERIFICATION_SERVICE_URL=
RIDESYNC_KYC_PROVIDER=mock_compliance_provider
RIDESYNC_VERIFICATION_INLINE_FALLBACK=true
RIDESYNC_REDIS_URL=redis://127.0.0.1:6379/2

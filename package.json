{
  "name": "ridesync",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "php tools/quality_gate.php",
    "test:unit": "vendor/bin/phpunit",
    "test:syntax": "php tools/quality_gate.php --syntax-only",
    "test:db": "php tools/db_bootstrap_check.php",
    "test:api:negative": "php tests/api/negative_api.php",
    "test:api:auth": "php tests/api/authenticated_api.php",
    "test:api:contract": "php tests/api/openapi_contract.php",
    "test:regression": "php tests/regression/ride_status_and_match_integrity.php && php tests/regression/session_principal_integrity.php && php tests/regression/security_surface_hardening.php",
    "gate:deployment": "php tools/deployment_readiness_gate.php",
    "test:ai-service": "python apps/ai-verification/scripts/selftest_service.py",
    "test:kyc-provider": "python apps/ai-verification/scripts/validate_provider_contract.py",
    "test:load": "k6 run tests/load/k6-smoke.js",
    "test:load:production": "k6 run tests/load/k6-production.js",
    "postinstall": "npm --prefix realtime/websocket-gateway ci --omit=dev",
    "worker:verification": "php tools/queue_worker.php --watch --queue=verification",
    "worker:maintenance": "php tools/prune_runtime_tables.php",
    "ws:gateway": "cd realtime/websocket-gateway && npm start",
    "ws:check": "cd realtime/websocket-gateway && npm run check && npm run startup-check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaunakjaiwant/ridesync.git"
  },
  "bugs": {
    "url": "https://github.com/shaunakjaiwant/ridesync/issues"
  },
  "homepage": "https://github.com/shaunakjaiwant/ridesync#readme"
}

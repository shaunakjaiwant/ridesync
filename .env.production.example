# RideSync Production Environment Configuration Example
# Copy or set these environment variables in your Render Web Service dashboard

RIDESYNC_ENV=production
RIDESYNC_DEBUG=false
RIDESYNC_TIMEZONE=Asia/Kolkata

# Database configuration (Aiven for MySQL / TiDB Cloud / Alwaysdata)
RIDESYNC_DB_HOST=mysql-ridesync-yourhost.aivencloud.com
RIDESYNC_DB_PORT=3306
RIDESYNC_DB_NAME=ridesync_db
RIDESYNC_DB_USER=avnadmin
RIDESYNC_DB_PASSWORD=your_secure_db_password
RIDESYNC_DB_CONNECT_TIMEOUT=10

# Security & Proxies (Must be true on Render / Vercel HTTPS)
RIDESYNC_TRUST_PROXY=true
RIDESYNC_COOKIE_SECURE=true
RIDESYNC_ENABLE_CSP=true

# Secrets (Generate 32-byte Base64 strings or random tokens)
RIDESYNC_DOCUMENT_ENCRYPTION_KEY=Base64RandomKey32BytesLongHereEqual=
RIDESYNC_REPAIR_LOG_KEY=Base64RandomKey32BytesLongHereEqual=
RIDESYNC_METRICS_TOKEN=YourMetricsToken32CharsLongHere
RIDESYNC_VERIFICATION_SERVICE_TOKEN=YourVerificationToken32CharsLong
RIDESYNC_WS_SHARED_TOKEN=YourWebSocketSharedToken32CharsLong

# Verification & KYC options
RIDESYNC_KYC_PROVIDER=mock_compliance_provider
RIDESYNC_VERIFICATION_ASYNC=false
RIDESYNC_VERIFICATION_INLINE_FALLBACK=true

# Realtime WebSockets
RIDESYNC_WEBSOCKET_URL=wss://ridesync-ws.onrender.com/ridesync/ws
RIDESYNC_WS_PORT=8081
RIDESYNC_WS_POLL_MS=1500

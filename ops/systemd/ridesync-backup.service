[Unit]
Description=RideSync MySQL backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/html/ridesync
EnvironmentFile=/etc/ridesync/backup.env
ExecStart=/var/www/html/ridesync/ops/backup_mysql.sh
User=ridesync
Group=ridesync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/ridesync /var/www/html/ridesync/storage/backups

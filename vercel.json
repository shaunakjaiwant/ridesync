{
  "version": 2,
  "name": "ridesync",
  "headers": [
    {
      "source": "/ridesync/(css|js|assets|uploads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js|assets|uploads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|gif|svg|webp|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/ridesync/(.*)",
      "dest": "https://ridesync-app-81i7.onrender.com/ridesync/$1"
    },
    {
      "src": "/(.*)",
      "dest": "https://ridesync-app-81i7.onrender.com/ridesync/$1"
    }
  ]
}

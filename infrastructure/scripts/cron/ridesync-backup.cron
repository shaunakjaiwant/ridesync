# Run as the application deploy user. Environment values should be loaded from
# a root-readable secret file before this cron is installed.
#
# Example install:
# crontab infrastructure/scripts/cron/ridesync-backup.cron

RIDESYNC_DB_HOST=127.0.0.1
RIDESYNC_DB_PORT=3306
RIDESYNC_DB_NAME=ridesync_db
RIDESYNC_DB_USER=ridesync_app
RIDESYNC_BACKUP_DIR=/var/backups/ridesync

# Daily encrypted/off-host backup handoff should be handled by the platform.
15 2 * * * cd /var/www/html/ridesync && . /etc/ridesync/backup.env && ./infrastructure/scripts/backup_mysql.sh >> /var/log/ridesync-backup.log 2>&1
